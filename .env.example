# Server Configuration
PORT=8080
ALLOWED_ORIGINS=http://localhost:8080,http://10.0.2.2:8080

# PostgreSQL Database (Provide DATABASE_URL directly, or individual host/port/name vars)
DATABASE_URL=jdbc:postgresql://localhost:5432/weatherengine
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=weatherengine
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
SQL_INIT_MODE=always

# Redis Cache (15-minute TTL)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
SPRING_CACHE_TYPE=redis

# JWT Authentication (Must be at least 32 characters / 256 bits)
JWT_SECRET=replace-with-a-secure-random-256-bit-secret-key-in-production
JWT_EXPIRATION_MS=86400000

# Weather Providers (Open-Meteo requires no API key)
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_AIR_QUALITY_URL=https://air-quality-api.open-meteo.com/v1/air-quality
