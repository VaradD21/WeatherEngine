# ===================================================================
# WeatherEngine Environment Configuration Template
# ===================================================================

# --- Spring Boot Backend Configuration ---
PORT=8080
SPRING_CACHE_TYPE=redis
REDIS_HOST=localhost
REDIS_PORT=6379
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=weatherengine
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
JWT_SECRET=weatherengine-dev-secret-key-must-be-at-least-32-bytes-long
JWT_EXPIRATION_MS=86400000

# --- External Weather & Air Quality Providers ---
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_AIR_QUALITY_URL=https://air-quality-api.open-meteo.com/v1/air-quality
WEATHERAPI_KEY=
WEATHERAPI_URL=https://api.weatherapi.com/v1/forecast.json
FREEOPENAPI_BASE_URL=https://freeopenapi.dev/api/v1/weather
OPENWEATHER_API_KEY=
TOMORROW_IO_KEY=

# --- Android Connection Targets ---
ANDROID_ACTIVE_TARGET=EMULATOR
ANDROID_EMULATOR_URL=http://10.0.2.2:8080
ANDROID_PHONE_LAN_URL=http://192.168.1.100:8080
ANDROID_USB_ADB_URL=http://localhost:8080
