<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/glance_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_glass_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/glance_location"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="WeatherEngine"
            android:textColor="#F1F5F9"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/glance_condition"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Partly Cloudy"
            android:textColor="#94A3B8"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/glance_badge_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:background="@drawable/widget_pill_bg"
            android:paddingStart="6dp"
            android:paddingTop="1dp"
            android:paddingEnd="6dp"
            android:paddingBottom="1dp"
            android:text="AQI Good"
            android:textColor="#38BDF8"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/glance_temperature"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="--°"
        android:textColor="#38BDF8"
        android:textSize="32sp"
        android:textStyle="bold" />

</LinearLayout>
