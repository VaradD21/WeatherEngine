<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      Debug-only manifest overlay.
      Permits cleartext HTTP traffic specifically for local development and emulator (e.g. 10.0.2.2:8080).
      Release builds ignore this overlay and reject non-HTTPS traffic.
    -->
    <application
        android:networkSecurityConfig="@xml/network_security_config" />
</manifest>
