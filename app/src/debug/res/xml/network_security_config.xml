<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only network security configuration.
  Permits cleartext HTTP traffic for local backend development on localhost, 10.0.2.2 (emulator host),
  and LAN IPs so developers can test against local Spring Boot instances.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
